# Connection string Postgres (Supabase), région EU.
# Utiliser le POOLER en mode SESSION (port 5432) : fiable avec postgres-js en
# local ET en serverless (le mode transaction 6543 bloque sur la 1re requête).
# Encoder le mot de passe en pourcent si caractères spéciaux (/ # ! ? → %2F %23 %21 %3F).
#   DATABASE_URL=postgresql://postgres.<ref>:<motdepasse>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Mettre "disable" uniquement pour un Postgres local sans SSL. Par défaut : SSL requis.
# DATABASE_SSL=disable

# --- Console d'administration (/admin) ---------------------------------------
# Tant que ces trois variables manquent, la console reste fermée : elle ne
# bascule jamais en accès libre, contrairement au mode présentateur.
#
# Identifiants OAuth d'un client « Application Web » de la console Google Cloud.
# Adresses de redirection autorisées à y déclarer, une par domaine servi :
#   https://keo.agenia.pro/api/admin/retour
#   https://immomail-studio.vercel.app/api/admin/retour
#   http://localhost:3000/api/admin/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret de signature du cookie de session — 24 caractères minimum, tiré au
# hasard. Le changer déconnecte immédiatement les sessions en cours.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Seule adresse Google admise dans la console. Par défaut : cojagregory@gmail.com.
# ADMIN_EMAIL=
